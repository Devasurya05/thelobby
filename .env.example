APP_NAME="The Lobby"
# On the live server use APP_ENV=production and APP_DEBUG=false (debug pages show internals to strangers).
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily = one log file per day in storage/logs, old ones deleted after 14 days
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thelobby
DB_USERNAME=thelobby
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cookies must NOT be marked Secure while we serve plain HTTP (local network / EC2 IP), or phones will drop them.
# Set to true once HTTPS is in place.
SESSION_SECURE_COOKIE=false

# Lobby: seconds a bed is held before it is released (120 = 2 minutes; use 30 for a quick demo)
HOLD_SECONDS=120

# Password for the owner-only page /admin/errors. At least 16 characters; leave empty to switch the admin pages off.
ADMIN_KEY=

# The two PRETEND booking sites (DemoStay, DemoFly) under /demo. Set to false to switch them off completely.
DEMO_PARTNERS=true

# Webhook signing secrets, one per booking site. Leave EMPTY for the pretend sites: the secret is then derived
# from APP_KEY, so there is nothing extra to create or leak. A real partner would get its own long random value.
PARTNER_STAY_SECRET=
PARTNER_FLY_SECRET=
